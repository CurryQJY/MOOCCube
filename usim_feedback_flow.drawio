<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17">
  <diagram id="usim-feedback-flow" name="USIM-Feedback Flow">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="USIM-Feedback Architecture and Data Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="20" width="880" height="40" as="geometry" />
        </mxCell>

        <mxCell id="train-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1120" height="1380" as="geometry" />
        </mxCell>
        <mxCell id="eval-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1210" y="90" width="1120" height="1380" as="geometry" />
        </mxCell>

        <mxCell id="train-title" value="Training Flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="110" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eval-title" value="Evaluation and Ranking Flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1605" y="110" width="330" height="50" as="geometry" />
        </mxCell>

        <mxCell id="train-input" value="Input batch&#xa;(u, i, pop, llm_s)&#xa;from StreamDataset / collate_fn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="90" y="210" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="train-user" value="User encoder&#xa;user_emb(u) -&gt; user_proj&#xa;z_u_base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="90" y="370" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="train-item" value="Item encoder&#xa;item_emb(i) + content_proj(content_i) + llm score&#xa;gate fusion -&gt; z_i_base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="500" y="210" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="train-init" value="Initialize rollout state&#xa;current_h = z_i_base" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="625" y="380" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="train-bank" value="User bank&#xa;normalize(user_proj(user_emb(all users)))&#xa;cached for retrieve_sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="910" y="210" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="loop-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f9ff;strokeColor=#4a86e8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="520" width="600" height="470" as="geometry" />
        </mxCell>
        <mxCell id="loop-title" value="Feedback-aware imagined interaction loop (t = 0 ... T-1)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="535" width="470" height="30" as="geometry" />
        </mxCell>
        <mxCell id="loop-cand" value="Candidate retrieval&#xa;get_candidates(current_h, user_bank_raw)&#xa;retrieve_sample -> Ncand user embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="500" y="585" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="loop-agent" value="PPO agent&#xa;get_action_value(current_h, time_step, candidates)&#xa;-> action, log_prob, value, entropy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="780" y="585" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="loop-select" value="Select candidate user&#xa;selected_user = candidates[action_idx]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="730" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="loop-update" value="State update&#xa;score = &lt;h, selected_user&gt;&#xa;grad = d score / d h&#xa;current_h = current_h + usim_lr * grad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="585" y="845" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="reward-box" value="Feedback reward&#xa;prev_dist = MSE(prev_h, target_emb)&#xa;new_dist = MSE(current_h, target_emb)&#xa;reward = - term_w * new_dist&#xa;+ gain_w * clip(prev_dist - new_dist)&#xa;- dup_w * candidate_dup_rate&#xa;+ cov_w * topm_coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="120" y="670" width="290" height="210" as="geometry" />
        </mxCell>
        <mxCell id="traj-box" value="Trajectory buffer&#xa;states, time_steps, candidates, actions&#xa;log_probs, values, rewards, entropies&#xa;+ candidate stats: dup_rate, coverage, step_gain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="890" y="730" width="190" height="160" as="geometry" />
        </mxCell>

        <mxCell id="train-final" value="final_h&#xa;(rollout output)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="605" y="1040" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="train-score" value="Main similarity score&#xa;dot(normalize(z_u_base), normalize(final_h))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="285" y="1185" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="train-ppo" value="PPO loss&#xa;compute_ppo_loss(trajectory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="1185" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="train-course" value="Course priors (shared from usim.py)&#xa;prereq_aux_loss&#xa;optional course rerank / hard negatives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="1185" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="train-loss" value="Total training loss&#xa;InfoNCE + aux_loss + PPO_loss + prereq_aux_loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="1335" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="eval-input" value="Evaluation inputs&#xa;eval loader + llm_scores + user_seen_items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1290" y="210" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eval-itembank" value="Build all item vectors&#xa;build_all_item_vecs(model, llm_scores)&#xa;z_item_all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1680" y="210" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eval-user" value="User vectors&#xa;z_u = normalize(user_proj(user_emb(u)))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1290" y="370" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eval-score" value="Scoring against item pool&#xa;sampled: 1 + n_neg candidates&#xa;or full-ranking: all items except seen history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1670" y="370" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eval-mask" value="Seen-history mask&#xa;exclude train/history interactions&#xa;before ranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="2050" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eval-rank" value="Ranking metrics&#xa;Recall@K / NDCG@K&#xa;cold split and hot split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1715" y="540" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eval-stream" value="Streaming protocol&#xa;period t evaluation uses history up to t-1&#xa;then period t is added to training data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1495" y="710" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eval-note" value="Key difference from original USIM&#xa;reward loop now uses step improvement + collapse penalty&#xa;to make imagined interaction more feedback-aware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1455" y="900" width="510" height="120" as="geometry" />
        </mxCell>

